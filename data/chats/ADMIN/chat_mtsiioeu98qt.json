            "code": "<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>توپ سه بعدی خفن</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            overflow: hidden;\n            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n\n        canvas {\n            display: block;\n        }\n\n        .instructions {\n            position: fixed;\n            bottom: 30px;\n            left: 50%;\n            transform: translateX(-50%);\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 18px;\n            text-align: center;\n            pointer-events: none;\n            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 0.7; }\n            50% { opacity: 1; }\n        }\n\n        .title {\n            position: fixed;\n            top: 30px;\n            left: 50%;\n            transform: translateX(-50%);\n            color: #fff;\n            font-size: 28px;\n            font-weight: bold;\n            text-shadow: 0 0 20px rgba(100, 200, 255, 0.8), 0 0 40px rgba(100, 200, 255, 0.4);\n            pointer-events: none;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"title\">🏀 توپ سه بعدی</div>\n    <div class=\"instructions\">🎮 توپ رو بکشید و پرتش کنید!</div>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n    <script>\n        // Scene Setup\n        const scene = new THREE.Scene();\n        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n        renderer.shadowMap.enabled = true;\n        renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n        renderer.toneMapping = THREE.ACESFilmicToneMapping;\n        renderer.toneMappingExposure = 1.2;\n        document.body.appendChild(renderer.domElement);\n\n        camera.position.set(0, 2, 8);\n        camera.lookAt(0, 0, 0);\n\n        // Lights\n        const ambientLight = new THREE.AmbientLight(0x404040, 0.5);\n        scene.add(ambientLight);\n\n        const mainLight = new THREE.DirectionalLight(0xffffff, 1);\n        mainLight.position.set(10, 20, 10);\n        mainLight.castShadow = true;\n        mainLight.shadow.mapSize.width = 2048;\n        mainLight.shadow.mapSize.height = 2048;\n        mainLight.shadow.camera.near = 0.5;\n        mainLight.shadow.camera.far = 50;\n        mainLight.shadow.camera.left = -15;\n        mainLight.shadow.camera.right = 15;\n        mainLight.shadow.camera.top = 15;\n        mainLight.shadow.camera.bottom = -15;\n        scene.add(mainLight);\n\n        // Colored accent lights\n        const blueLight = new THREE.PointLight(0x4488ff, 1, 20);\n        blueLight.position.set(-5, 5, 5);\n        scene.add(blueLight);\n\n        const pinkLight = new THREE.PointLight(0xff4488, 1, 20);\n        pinkLight.position.set(5, 3, -5);\n        scene.add(pinkLight);\n\n        const orangeLight = new THREE.PointLight(0xffaa44, 0.8, 15);\n        orangeLight.position.set(0, 8, 0);\n        scene.add(orangeLight);\n\n        // Floor\n        const floorGeometry = new THREE.PlaneGeometry(30, 30);\n        const floorMaterial = new THREE.MeshStandardMaterial({\n            color: 0x1a1a2e,\n            roughness: 0.8,\n            metalness: 0.2\n        });\n        const floor = new THREE.Mesh(floorGeometry, floorMaterial);\n        floor.rotation.x = -Math.PI / 2;\n        floor.position.y = -3;\n        floor.receiveShadow = true;\n        scene.add(floor);\n\n        // Grid helper\n        const gridHelper = new THREE.GridHelper(30, 30, 0x444466, 0x222244);\n        gridHelper.position.y = -2.99;\n        scene.add(gridHelper);\n\n        // Create the amazing 3D ball\n        const ballRadius = 1.2;\n        const ballGeometry = new THREE.SphereGeometry(ballRadius, 64, 64);\n\n        // Create custom shader material for a cool basketball look\n        const ballMaterial = new THREE.MeshPhysicalMaterial({\n            color: 0xff6600,\n            roughness: 0.3,\n            metalness: 0.1,\n            clearcoat: 0.8,\n            clearcoatRoughness: 0.2,\n            reflectivity: 0.9,\n            envMapIntensity: 1\n        });\n\n        const ball = new THREE.Mesh(ballGeometry, ballMaterial);\n        ball.castShadow = true;\n        ball.position.y = 0;\n        scene.add(ball);\n\n        // Ball lines (basketball pattern)\n        const lineMaterial = new THREE.LineBasicMaterial({ color: 0x000000, linewidth: 2 });\n\n        // Create basketball lines\n        function createBallLines() {\n            const linesGroup = new THREE.Group();\n            const segments = 32;\n            const rings = 16;\n\n            // Horizontal rings\n            for (let i = 1; i < rings; i++) {\n                const phi = (i / rings) * Math.PI;\n                const points = [];\n                for (let j = 0; j <= segments; j++) {\n                    const theta = (j / segments) * Math.PI * 2;\n                    const x = ballRadius * Math.sin(phi) * Math.cos(theta);\n                    const y = ballRadius * Math.cos(phi);\n                    const z = ballRadius * Math.sin(phi) * Math.sin(theta);\n                    points.push(new THREE.Vector3(x, y, z));\n                }\n                const geometry = new THREE.BufferGeometry().setFromPoints(points);\n                const line = new THREE.Line(geometry, lineMaterial);\n                linesGroup.add(line);\n            }\n\n            // Vertical lines\n            for (let i = 0; i < 8; i++) {\n                const theta = (i / 8) * Math.PI * 2;\n                const points = [];\n                for (let j = 0; j <= segments; j++) {\n                    const phi = (j / segments) * Math.PI;\n                    const x = ballRadius * Math.sin(phi) * Math.cos(theta);\n                    const y = ballRadius * Math.cos(phi);\n                    const z = ballRadius * Math.sin(phi) * Math.sin(theta);\n                    points.push(new THREE.Vector3(x, y, z));\n                }\n                const geometry = new THREE.BufferGeometry().setFromPoints(points);\n                const line = new THREE.Line(geometry, lineMaterial);\n                linesGroup.add(line);\n            }\n\n            return linesGroup;\n        }\n\n        const ballLines = createBallLines();\n        ball.add(ballLines);\n\n        // Environment map for reflections\n        const cubeTextureLoader = new THREE.CubeTextureLoader();\n        const envMapUrls = [];\n        const envColors = ['#4488ff', '#ff4488', '#44ff88', '#ffff44', '#ff8844', '#8844ff'];\n\n        // Create simple environment\n        const pmremGenerator = new THREE.PMREMGenerator(renderer);\n        scene.environment = pmremGenerator.fromScene(new THREE.Scene()).texture;\n\n        // Physics state\n        let velocity = new THREE.Vector3(0, 0, 0);\n        let angularVelocity = new THREE.Vector3(0, 0, 0);\n        const gravity = -15;\n        const bounceFactor = 0.7;\n        const friction = 0.98;\n        const groundY = -1.8;\n        const airResistance = 0.995;\n\n        // Mouse interaction\n        let isDragging = false;\n        let previousMousePosition = new THREE.Vector2();\n        let dragStartPosition = new THREE.Vector3();\n        let ballStartPosition = new THREE.Vector3();\n\n        const raycaster = new THREE.Raycaster();\n        const mouse = new THREE.Vector2();\n\n        function getMousePosition(event) {\n            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n        }\n\n        function checkBallHit(event) {\n            getMousePosition(event);\n            raycaster.setFromCamera(mouse, camera);\n            const intersects = raycaster.intersectObject(ball);\n            return intersects.length > 0;\n        }\n\n        // Touch events\n        renderer.domElement.addEventListener('touchstart', (e) => {\n            e.preventDefault();\n            if (checkBallHit(e.touches[0])) {\n                isDragging = true;\n                const touch = e.touches[0];\n                previousMousePosition.set(touch.clientX, touch.clientY);\n                dragStartPosition.set(touch.clientX, touch.clientY, 0);\n                ballStartPosition.copy(ball.position);\n                velocity.set(0, 0, 0);\n                angularVelocity.set(0, 0, 0);\n            }\n        }, { passive: false });\n\n        renderer.domElement.addEventListener('touchmove', (e) => {\n            if (isDragging) {\n                e.preventDefault();\n                const touch = e.touches[0];\n                const deltaX = (touch.clientX - previousMousePosition.x) * 0.02;\n                const deltaY = (touch.clientY - previousMousePosition.y) * 0.02;\n\n                // Move ball based on drag\n                ball.position.x += deltaX;\n                ball.position.y -= deltaY;\n\n                // Add rotation based on drag\n                angularVelocity.z = -deltaX * 5;\n                angularVelocity.x = deltaY * 5;\n\n                previousMousePosition.set(touch.clientX, touch.clientY);\n            }\n        }, { passive: false });\n\n        renderer.domElement.addEventListener('touchend', (e) => {\n            if (isDragging) {\n                isDragging = false;\n                const touch = e.changedTouches[0];\n                const deltaX = (touch.clientX - dragStartPosition.x) * 0.15;\n                const deltaY = (touch.clientY - dragStartPosition.y) * 0.15;\n\n                // Apply throw velocity\n                velocity.x = deltaX;\n                velocity.y = -deltaY * 0.5;\n                velocity.z = deltaX * 0.5;\n            }\n        });\n\n        // Mouse events\n        renderer.domElement.addEventListener('mousedown', (e) => {\n            if (checkBallHit(e)) {\n                isDragging = true;\n                previousMousePosition.set(e.clientX, e.clientY);\n                dragStartPosition.set(e.clientX, e.clientY, 0);\n                ballStartPosition.copy(ball.position);\n                velocity.set(0, 0, 0);\n                angularVelocity.set(0, 0, 0);\n            }\n        });\n\n        renderer.domElement.addEventListener('mousemove', (e) => {\n            if (isDragging) {\n                const deltaX = (e.clientX - previousMousePosition.x) * 0.02;\n                const deltaY = (e.clientY - previousMousePosition.y) * 0.02;\n\n                ball.position.x += deltaX;\n                ball.position.y -= deltaY;\n\n                angularVelocity.z = -deltaX * 5;\n                angularVelocity.x = deltaY * 5;\n\n                previousMousePosition.set(e.clientX, e.clientY);\n            }\n        });\n\n        renderer.domElement.addEventListener('mouseup', (e) => {\n            if (isDragging) {\n                isDragging = false;\n                const deltaX = (e.clientX - dragStartPosition.x) * 0.15;\n                const deltaY = (e.clientY - dragStartPosition.y) * 0.15;\n\n                velocity.x = deltaX;\n                velocity.y = -deltaY * 0.5;\n                velocity.z = deltaX * 0.5;\n            }\n        });\n\n        // Animation particles for effect\n        const particleCount = 100;\n        const particleGeometry = new THREE.BufferGeometry();\n        const particlePositions = new Float32Array(particleCount * 3);\n        const particleSpeeds = [];\n\n        for (let i = 0; i < particleCount; i++) {\n            particlePositions[i * 3] = (Math.random() - 0.5) * 20;\n            particlePositions[i * 3 + 1] = Math.random() * 10 - 2;\n            particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 20;\n            particleSpeeds.push({\n                x: (Math.random() - 0.5) * 0.02,\n                y: (Math.random() - 0.5) * 0.02,\n                z: (Math.random() - 0.5) * 0.02\n            });\n        }\n\n        particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));\n        const particleMaterial = new THREE.PointsMaterial({\n            color: 0x88aaff,\n            size: 0.05,\n            transparent: true,\n            opacity: 0.6\n        });\n        const particles = new THREE.Points(particleGeometry, particleMaterial);\n        scene.add(particles);\n\n        // Animation loop\n        let time = 0;\n        function animate() {\n            requestAnimationFrame(animate);\n            time += 0.016;\n\n            if (!isDragging) {\n                // Apply gravity\n                velocity.y += gravity * 0.016;\n\n                // Apply air resistance\n                velocity.multiplyScalar(airResistance);\n                angularVelocity.multiplyScalar(0.99);\n\n                // Update position\n                ball.position.add(velocity.clone().multiplyScalar(0.016));\n\n                // Ground collision\n                if (ball.position.y < groundY + ballRadius) {\n                    ball.position.y = groundY + ballRadius;\n                    velocity.y = -velocity.y * bounceFactor;\n                    velocity.x *= 0.9;\n                    velocity.z *= 0.9;\n                    angularVelocity.x *= 0.8;\n                    angularVelocity.z *= 0.8;\n                }\n\n                // Wall collisions\n                if (Math.abs(ball.position.x) > 10) {\n                    velocity.x = -velocity.x * 0.8;\n                    ball.position.x = Math.sign(ball.position.x) * 10;\n                }\n                if (Math.abs(ball.position.z) > 10) {\n                    velocity.z = -velocity.z * 0.8;\n                    ball.position.z = Math.sign(ball.position.z) * 10;\n                }\n\n                // Apply rotation\n                ball.rotation.x += angularVelocity.x * 0.016;\n                ball.rotation.z += angularVelocity.z * 0.016;\n            }\n\n            // Ball bounce animation when idle\n            if (!isDragging && velocity.length() < 0.1) {\n                ball.position.y = groundY + ballRadius + Math.sin(time * 3) * 0.1;\n            }\n\n            // Animate lights\n            blueLight.position.x = Math.sin(time * 0.5) * 6;\n            blueLight.position.z = Math.cos(time * 0.5) * 6;\n            pinkLight.position.x = Math.cos(time * 0.5) * 6;\n            pinkLight.position.z = Math.sin(time * 0.5) * 6;\n\n            // Animate particles\n            const positions = particles.geometry.attributes.position.array;\n            for (let i = 0; i < particleCount; i++) {\n                positions[i * 3] += particleSpeeds[i].x;\n                positions[i * 3 + 1] += particleSpeeds[i].y;\n                positions[i * 3 + 2] += particleSpeeds[i].z;\n\n                // Reset particles that go out of bounds\n                if (Math.abs(positions[i * 3]) > 10) particleSpeeds[i].x *= -1;\n                if (positions[i * 3 + 1] > 8 || positions[i * 3 + 1] < -2) particleSpeeds[i].y *= -1;\n                if (Math.abs(positions[i * 3 + 2]) > 10) particleSpeeds[i].z *= -1;\n            }\n            particles.geometry.attributes.position.needsUpdate = true;\n\n            // Ball material color animation\n            const hue = (time * 0.05) % 1;\n            ballMaterial.color.setHSL(hue, 0.8, 0.5);\n\n            renderer.render(scene, camera);\n        }\n\n        // Handle resize\n        window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        animate();\n    </script>\n</body>\n</html>",
